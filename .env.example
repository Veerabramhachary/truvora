# Database
# Neon (or any Postgres) connection string.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"
DATABASE_URL_POOLED= ""

# Site
# Production origin. Used by the root metadata, sitemap.ts and robots.ts so
# crawled URLs and Open Graph links resolve to the real domain. Falls back to
# http://localhost:3000 if unset, which produces a useless sitemap.
NEXT_PUBLIC_APP_URL=""

# Clerk
CLERK_SECRET_KEY="sk_test_..."
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_..."
# Svix signing secret, shown when you create the webhook endpoint in the
# Clerk dashboard. Required by /api/webhooks/clerk.
CLERK_WEBHOOK_SECRET="whsec_..."

# Stripe
STRIPE_SECRET_KEY="sk_test_..."
# Signing secret of the Stripe webhook endpoint. Required by
# /api/webhooks/stripe.
STRIPE_WEBHOOK_SECRET="whsec_..."

# Encryption
# Passphrase and salt used to derive the AES-256-GCM key that encrypts the
# `description` / `note` / `metadata` columns.
#
# WARNING: there is no key rotation path. Changing either value makes every
# existing encrypted value permanently unreadable.
ENCRYPTION_PASSPHRASE=""
ENCRYPTION_SALT=""

# Email (renewal reminders)
RESEND_API_KEY="re_..."

# Cron
# Bearer token expected by the /api/crons/* routes. Vercel sends this
# automatically when CRON_SECRET is set on the project.
CRON_SECRET=""

# Seed scripts only. The Clerk user id that the sample data is attached to.
DEV_ID=""
