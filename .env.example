# Database
# Neon (or any Postgres) connection string.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Site
# Production origin. Used by the root metadata, sitemap.ts and robots.ts so
# crawled URLs and Open Graph links resolve to the real domain. Falls back to
# http://localhost:3000 if unset, which produces a useless sitemap.
NEXT_PUBLIC_APP_URL=""

# Clerk
CLERK_SECRET_KEY="sk_test_..."
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_..."
# Svix signing secret, shown when you create the webhook endpoint in the
# Clerk dashboard. Required by /api/webhooks/clerk.
CLERK_WEBHOOK_SECRET="whsec_..."

# Encryption
# Passphrase and salt used to derive the AES-256-GCM key that encrypts the
# `description` / `note` / `metadata` columns.
#
# WARNING: there is no key rotation path. Changing either value makes every
# existing encrypted value permanently unreadable.
ENCRYPTION_PASSPHRASE=""
ENCRYPTION_SALT=""

# Email (renewal reminders). RESEND_API_KEY is a server-side secret. Set
# RENEWAL_EMAIL_FROM to a sender address on a domain verified in Resend, for
# example: "Truvora <reminders@your-verified-domain.com>".
RESEND_API_KEY="re_..."
RENEWAL_EMAIL_FROM="Truvora <reminders@your-verified-domain.com>"

# Public support contact shown in privacy and account deletion flows.
NEXT_PUBLIC_SUPPORT_EMAIL=""

# Cron
# Bearer token expected by the /api/crons/* routes. Vercel sends this
# automatically when CRON_SECRET is set on the project.
CRON_SECRET=""

# Shared API rate limiting (Upstash Redis REST credentials).
# When omitted, requests continue and a server-side warning is logged.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Sentry 
SENTRY_AUTH_TOKEN=

# Razorpay checkout. Use test keys (rzp_test_...) locally and live keys only
# after staging passes. NEVER prefix the secret with NEXT_PUBLIC_ or read it
# in a client component.
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
# From Razorpay Dashboard → Settings → Webhooks. Required by
# /api/webhooks/razorpay; without it the route returns 503.
RAZORPAY_WEBHOOK_SECRET=""

# Seed scripts only. The Clerk user id that the sample data is attached to.
DEV_ID=""
