+-- READ-ONLY. Run BEFORE applying 0013_subscription_cycle_unique.
+--
+-- 1) Duplicate (subscription_id, date) pairs would make the unique index fail
+--    to build. Expect ZERO rows. Anything returned needs a decision (usually
+--    delete the extra copy) before migrating.
+SELECT subscription_id, date, count(*) AS copies, array_agg(id ORDER BY created_at) AS transaction_ids
+  FROM transactions
+ WHERE subscription_id IS NOT NULL
+ GROUP BY subscription_id, date
+HAVING count(*) > 1;
+
+-- 2) Preview of the first renewal run: how many subscriptions already have a
+--    next_date in the past (their nextDate was never advanced before this
+--    job existed). Each of these will be caught up on the first run.
+--    Prefer the job's own dry run:  GET /api/crons/subscription-renewals?dryRun=1
+SELECT count(*) AS subscriptions_due_now,
+       min(next_date) AS oldest_next_date
+  FROM subscriptions
+ WHERE next_date <= now();
diff -ruN -x node_modules -x .git base/truvora-main/lib/active-subscription.ts tv2/truvora-main/lib/active-subscription.ts
--- base/truvora-main/lib/active-subscription.ts	1970-01-01 00:00:00.000000000 +0000
+++ tv2/truvora-main/lib/active-subscription.ts	2026-11-02 05:41:12.611510913 +0000
@@ -0,0 +1,118 @@
+import { and, eq, gt, gte, isNull, lte, or, sql, type SQL } from "drizzle-orm";
+import { db } from "@/db";
+import { subscriptions } from "@/db/schema/schema";
+import { ledgers } from "@/db/schema/ledgers";
+import { featureUsage } from "@/db/schema/feature-usage";
+
+/**
+ * THE definition of an "active" subscription (F-04).
+ *
+ * A subscription counts as active right now when ALL of these hold:
+ *   1. its `active` flag is on,
+ *   2. `startDate <= now <= endDate`,
+ *   3. it has not been deactivated (`deactivatedAt IS NULL`),
+ *   4. its ledger is not archived. An archived ledger is frozen: its
+ *      subscriptions are not reminded about, not charged by the renewal job and
+ *      do not count against the plan limit. (Nothing archives a ledger yet;
+ *      whatever does must call `syncActiveSubscriptionUsage` for the owner,
+ *      because the stored usage counter is only refreshed on writes.)
+ *
+ * The dashboard, the subscription list, the plan limit, the export status and
+ * the reminder cron must all use this one condition so they can never
+ * disagree. Do not re-write it inline.
+ *
+ * `now` is passed in (instead of SQL `NOW()`) so one request evaluates every
+ * query against the same instant.
+ */
+export function activeSubscriptionNow(now: Date = new Date()): SQL {
+    return and(
+        eq(subscriptions.active, true),
+        lte(subscriptions.startDate, now),
+        gte(subscriptions.endDate, now),
+        isNull(subscriptions.deactivatedAt),
+        ledgerNotArchived(),
+    )!;
+}
+
+/** The subscription's ledger exists and has not been archived. */
+function ledgerNotArchived(): SQL {
+    return sql`EXISTS (SELECT 1 FROM ${ledgers} WHERE ${ledgers.id} = ${subscriptions.ledgerId} AND ${ledgers.archivedAt} IS NULL)`;
+}
+
+/**
+ * Point-in-time variant, used for "how many were active at the end of last
+ * month". The `active` flag only stores the current state and has no history,
+ * so history is judged from the dates alone: started on or before `asOf`, not
+ * yet ended, and not deactivated before `asOf`.
+ */
+export function activeSubscriptionAt(asOf: Date): SQL {
+    return and(
+        lte(subscriptions.startDate, asOf),
+        gte(subscriptions.endDate, asOf),
+        or(
+            isNull(subscriptions.deactivatedAt),
+            gt(subscriptions.deactivatedAt, asOf),
+        ),
+    )!;
+}
+
+/** `active` as a boolean column for SELECT lists (list screen, export). */
+export function activeSubscriptionFlag(now: Date = new Date()) {
+    return sql<boolean>`CASE WHEN ${activeSubscriptionNow(now)} THEN TRUE ELSE FALSE END`;
+}
+
+/** Plain-JS mirror of {@link activeSubscriptionNow}, kept for tests and UI. */
+export function isSubscriptionActiveNow(
+    row: {
+        active: boolean;
+        startDate: Date;
+        endDate: Date;
+        deactivatedAt: Date | null;
+        /** When the subscription's ledger was archived, if it was. */
+        ledgerArchivedAt?: Date | null;
+    },
+    now: Date = new Date(),
+): boolean {
+    return (
+        row.active &&
+        row.startDate <= now &&
+        row.endDate >= now &&
+        row.deactivatedAt === null &&
+        (row.ledgerArchivedAt ?? null) === null
+    );
+}
+
+type Executor = Pick<typeof db, "select" | "insert">;
+
+/**
+ * Number of active subscriptions a user has across all of their ledgers.
+ * This is what the plan limit is measured against.
+ */
+export async function countActiveSubscriptions(
+    executor: Executor,
+    userId: string,
+    now: Date = new Date(),
+): Promise<number> {
+    const [row] = await executor
+        .select({ count: sql<number>`count(*)::int` })
+        .from(subscriptions)
+        .where(and(eq(subscriptions.userId, userId), activeSubscriptionNow(now)));
+    return row?.count ?? 0;
+}
+
+/** Keeps the stored usage counter equal to {@link countActiveSubscriptions}. */
+export async function syncActiveSubscriptionUsage(
+    executor: Executor,
+    userId: string,
+    now: Date = new Date(),
+): Promise<number> {
+    const count = await countActiveSubscriptions(executor, userId, now);
+    await executor
+        .insert(featureUsage)
+        .values({ userId, feature: "subscriptions", period: "active", count })
+        .onConflictDoUpdate({
+            target: [featureUsage.userId, featureUsage.feature, featureUsage.period],
+            set: { count, updatedAt: now },
+        });
+    return count;
+}
