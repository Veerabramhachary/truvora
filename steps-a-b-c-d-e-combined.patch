diff -ruN -x node_modules -x .git base/truvora-main/app/onboarding/OnboardingWizard.tsx tv2/truvora-main/app/onboarding/OnboardingWizard.tsx
--- base/truvora-main/app/onboarding/OnboardingWizard.tsx	1970-01-01 00:00:00.000000000 +0000
