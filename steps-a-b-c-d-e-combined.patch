+++ tv2/truvora-main/deploy/crontab.example	2026-11-01 12:46:49.016934111 +0000
@@ -10,7 +10,11 @@
 #        TRUVORA_BASE_URL=https://app.example.com
 #        CRON_SECRET=<same value as on the app host>
 #      then: chmod 600 /etc/truvora/cron.env
-#   3. crontab -e  ->  paste the two lines below.
+#   3. crontab -e  ->  paste the three lines below.
+#
+# subscription-renewals runs first and subscriptionsTC (reminders) 30 minutes
+# later, so reminders see the already-advanced renewal dates.
 CRON_TZ=UTC
-0 0 * * * /opt/truvora/deploy/trigger-cron.sh subscriptionsTC  >> /var/log/truvora-cron.log 2>&1
+0 0 * * * /opt/truvora/deploy/trigger-cron.sh subscription-renewals >> /var/log/truvora-cron.log 2>&1
+30 0 * * * /opt/truvora/deploy/trigger-cron.sh subscriptionsTC  >> /var/log/truvora-cron.log 2>&1
 0 0 * * * /opt/truvora/deploy/trigger-cron.sh account-deletions >> /var/log/truvora-cron.log 2>&1
diff -ruN -x node_modules -x .git base/truvora-main/deploy/trigger-cron.ps1 tv2/truvora-main/deploy/trigger-cron.ps1
--- base/truvora-main/deploy/trigger-cron.ps1	2026-11-01 11:24:07.000000000 +0000
+++ tv2/truvora-main/deploy/trigger-cron.ps1	2026-11-01 12:46:49.016598063 +0000
@@ -6,7 +6,7 @@
 param(
     [string]$BaseUrl = $env:TRUVORA_BASE_URL,
     [string]$CronSecret = $env:CRON_SECRET,
-    [ValidateSet("all", "subscriptionsTC", "account-deletions")]
+    [ValidateSet("all", "subscription-renewals", "subscriptionsTC", "account-deletions")]
     [string]$Target = "all"
 )
 
@@ -15,7 +15,7 @@
 if (-not $CronSecret) { throw "pass -CronSecret or set CRON_SECRET" }
 
 $paths = if ($Target -eq "all") {
-    @("/api/crons/subscriptionsTC", "/api/crons/account-deletions")
+    @("/api/crons/subscription-renewals", "/api/crons/subscriptionsTC", "/api/crons/account-deletions")
 } else {
     @("/api/crons/$Target")
 }
diff -ruN -x node_modules -x .git base/truvora-main/deploy/trigger-cron.sh tv2/truvora-main/deploy/trigger-cron.sh
--- base/truvora-main/deploy/trigger-cron.sh	2026-11-01 11:24:07.000000000 +0000
+++ tv2/truvora-main/deploy/trigger-cron.sh	2026-11-01 12:46:49.016021404 +0000
@@ -3,7 +3,7 @@
 #
 # Usage:
 #   TRUVORA_BASE_URL=https://app.example.com CRON_SECRET=... \
-#     ./deploy/trigger-cron.sh [all|subscriptionsTC|account-deletions]
+#     ./deploy/trigger-cron.sh [all|subscription-renewals|subscriptionsTC|account-deletions]
 #
 # When run from crontab there is no interactive shell env, so put both
 # variables in a root-only file instead (chmod 600):
@@ -21,9 +21,10 @@
 
 target="${1:-all}"
 case "$target" in
-    all)                 endpoints=(/api/crons/subscriptionsTC /api/crons/account-deletions) ;;
-    subscriptionsTC|account-deletions) endpoints=("/api/crons/$target") ;;
-    *) echo "unknown target: $target (want all|subscriptionsTC|account-deletions)" >&2; exit 2 ;;
+    # Order matters: renewals advance nextDate before reminders read it.
+    all)                 endpoints=(/api/crons/subscription-renewals /api/crons/subscriptionsTC /api/crons/account-deletions) ;;
+    subscription-renewals|subscriptionsTC|account-deletions) endpoints=("/api/crons/$target") ;;
+    *) echo "unknown target: $target (want all|subscription-renewals|subscriptionsTC|account-deletions)" >&2; exit 2 ;;
 esac
 
 body_file="$(mktemp)"
