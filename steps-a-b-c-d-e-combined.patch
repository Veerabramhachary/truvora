diff -ruN -x node_modules -x .git base/truvora-main/drizzle/0014_onboarding_completed_at.sql tv2/truvora-main/drizzle/0014_onboarding_completed_at.sql
--- base/truvora-main/drizzle/0014_onboarding_completed_at.sql	1970-01-01 00:00:00.000000000 +0000
+++ tv2/truvora-main/drizzle/0014_onboarding_completed_at.sql	2026-11-01 18:50:53.831857880 +0000
@@ -0,0 +1,4 @@
+ALTER TABLE "users" ADD COLUMN IF NOT EXISTS "onboarding_completed_at" timestamp;--> statement-breakpoint
+-- Everyone who already has an account is treated as onboarded, so only
+-- accounts created AFTER this migration are sent through the sign-up wizard.
+UPDATE "users" SET "onboarding_completed_at" = now() WHERE "onboarding_completed_at" IS NULL;
