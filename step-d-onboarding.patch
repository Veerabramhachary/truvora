 import { NextResponse } from "next/server";
 import { z } from "zod";
 import { db } from "@/db";
@@ -107,3 +107,44 @@
     if (!ledger) throw new LedgerError("Ledger not found", 404);
     return ledger;
 }
+
+export type LedgerSummaryRow = Pick<Ledger, "id" | "type" | "name">;
+
+/**
+ * Creates the user's business ledger. Launch rule: at most one active
+ * business ledger per user (an application rule, not a schema constraint, so
+ * Phase 3 can lift it without a migration).
+ *
+ * Returns `created: false` with the existing ledger when one already exists,
+ * so callers choose their own behaviour: the ledgers API answers 409, the
+ * onboarding wizard treats it as success so a retry after a partial failure
+ * just works.
+ */
+export async function createBusinessLedger(
+    userId: string,
+    name: string,
+): Promise<{ ledger: LedgerSummaryRow; created: boolean }> {
+    const summary = { id: ledgers.id, type: ledgers.type, name: ledgers.name };
+    return db.transaction(async (tx) => {
+        // Serialize concurrent creates for one user so the cap cannot be raced.
+        await tx.execute(sql`SELECT pg_advisory_xact_lock(hashtext(${`ledger:${userId}`}))`);
+        const [existing] = await tx
+            .select(summary)
+            .from(ledgers)
+            .where(
+                and(
+                    eq(ledgers.ownerUserId, userId),
+                    eq(ledgers.type, "business"),
+                    isNull(ledgers.archivedAt),
+                ),
+            )
+            .limit(1);
+        if (existing) return { ledger: existing, created: false };
+
+        const [row] = await tx
+            .insert(ledgers)
+            .values({ ownerUserId: userId, type: "business", name })
+            .returning(summary);
+        return { ledger: row, created: true };
+    });
+}
diff -ruN -x node_modules -x .git stateC/truvora-main/lib/onboarding.ts tv2/truvora-main/lib/onboarding.ts
--- stateC/truvora-main/lib/onboarding.ts	1970-01-01 00:00:00.000000000 +0000
+++ tv2/truvora-main/lib/onboarding.ts	2026-11-01 16:53:11.279639705 +0000
@@ -0,0 +1,27 @@
+import { eq } from "drizzle-orm";
+import { db } from "@/db";
+import { users } from "@/db/schema/users";
+
+/**
+ * True while the user still has to finish (or skip) the sign-up wizard.
+ *
+ * - No `users` row yet (the Clerk webhook is a moment behind): still pending,
+ *   the wizard waits for the account to be ready.
+ * - `onboarding_completed_at` is NULL: pending. Existing users are backfilled
+ *   by migration 0014, so they are never pending.
+ * - A database error fails OPEN (not pending): a broken lookup must never lock
+ *   someone out of their dashboard.
+ */
+export async function needsOnboarding(userId: string): Promise<boolean> {
+    try {
+        const [row] = await db
+            .select({ completedAt: users.onboardingCompletedAt })
+            .from(users)
+            .where(eq(users.id, userId))
+            .limit(1);
+        return !row || row.completedAt === null;
+    } catch (error) {
+        console.error("Could not read onboarding status:", error);
+        return false;
+    }
+}
