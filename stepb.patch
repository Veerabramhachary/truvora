--- stateA/truvora-main/lib/subscription-cycles.ts	1970-01-01 00:00:00.000000000 +0000
+++ tv2/truvora-main/lib/subscription-cycles.ts	2026-11-01 12:46:34.251386747 +0000
@@ -0,0 +1,109 @@
+/**
+ * Billing-cycle maths for subscriptions (F-02/F-03).
+ *
+ * Pure functions, no database. Everything is computed in UTC, matching
+ * `nextRenewalDate` in app/api/subscriptions/schema.ts.
+ */
+
+/** Upper bound on cycles recorded for one subscription in one run. */
+export const MAX_CYCLES_PER_RUN = 120;
+
+function lastDayOfMonth(year: number, monthIndex: number): number {
+    return new Date(Date.UTC(year, monthIndex + 1, 0)).getUTCDate();
+}
+
+/**
+ * The cycle date after `current`.
+ *
+ * Steps whole cycles (`intervalCount` months, or years x 12) and keeps the
+ * time of day of `current`. The day of month is anchored on `startDate`, so a
+ * subscription started on the 31st bills Jan 31, Feb 28, Mar 31 instead of
+ * drifting to the 28th for good.
+ *
+ * If `current` sits on a day that is not the (clamped) start day, the user set
+ * the date by hand; that day becomes the anchor instead.
+ */
+export function nextCycleDate(
+    startDate: Date,
+    current: Date,
+    interval: string,
+    intervalCount: number,
+): Date {
+    const months =
+        (interval === "year" ? 12 : 1) * (intervalCount > 0 ? intervalCount : 1);
+    const currentYear = current.getUTCFullYear();
+    const currentMonth = current.getUTCMonth();
+
+    const startDay = startDate.getUTCDate();
+    const clampedStartDay = Math.min(startDay, lastDayOfMonth(currentYear, currentMonth));
+    const anchorDay =
+        current.getUTCDate() === clampedStartDay ? startDay : current.getUTCDate();
+
+    const monthIndex = currentYear * 12 + currentMonth + months;
+    const year = Math.floor(monthIndex / 12);
+    const month = monthIndex % 12;
+    const day = Math.min(anchorDay, lastDayOfMonth(year, month));
+
+    return new Date(
+        Date.UTC(
+            year,
+            month,
+            day,
+            current.getUTCHours(),
+            current.getUTCMinutes(),
+            current.getUTCSeconds(),
+            current.getUTCMilliseconds(),
+        ),
+    );
+}
+
+export type RenewalSubscription = {
+    active: boolean;
+    startDate: Date;
+    endDate: Date;
+    deactivatedAt: Date | null;
+    nextDate: Date;
+    interval: string;
+    intervalCount: number;
+};
+
+/**
+ * Was the subscription live on `date`, so that a charge on that date is real?
+ * Cycles that fall before the start, after the end, or in a period it was
+ * deactivated are advanced past without recording a charge.
+ */
+export function isChargeableOn(sub: RenewalSubscription, date: Date): boolean {
+    if (date < sub.startDate || date > sub.endDate) return false;
+    if (sub.deactivatedAt) return date < sub.deactivatedAt;
+    return sub.active;
+}
+
+export type PlannedCycle = { date: Date; charge: boolean };
+
+export type RenewalPlan = {
+    /** Every cycle date that has passed, oldest first. */
+    cycles: PlannedCycle[];
+    /** The value `nextDate` should be set to. */
+    nextDate: Date;
+    /** True when the per-run cap stopped us before reaching the future. */
+    capped: boolean;
+};
+
+/**
+ * Catch a subscription up to `now`: list each missed cycle (and whether it
+ * is a real charge) and the new `nextDate`. Never returns the same date twice,
+ * so it cannot double-count a cycle by itself.
+ */
+export function planRenewals(
+    sub: RenewalSubscription,
+    now: Date,
+    maxCycles: number = MAX_CYCLES_PER_RUN,
+): RenewalPlan {
+    const cycles: PlannedCycle[] = [];
+    let cursor = sub.nextDate;
+    while (cursor <= now && cycles.length < maxCycles) {
+        cycles.push({ date: cursor, charge: isChargeableOn(sub, cursor) });
+        cursor = nextCycleDate(sub.startDate, cursor, sub.interval, sub.intervalCount);
+    }
+    return { cycles, nextDate: cursor, capped: cursor <= now };
+}
diff -ruN -x node_modules -x .git stateA/truvora-main/lib/subscription-renewals.ts tv2/truvora-main/lib/subscription-renewals.ts
--- stateA/truvora-main/lib/subscription-renewals.ts	1970-01-01 00:00:00.000000000 +0000
+++ tv2/truvora-main/lib/subscription-renewals.ts	2026-11-01 12:46:34.252569547 +0000
@@ -0,0 +1,153 @@
+import { and, asc, eq, lte } from "drizzle-orm";
+import { db } from "@/db";
+import { subscriptions, transactions } from "@/db/schema/schema";
+import { planRenewals } from "./subscription-cycles";
+
+export type RenewalSummary = {
+    dryRun: boolean;
+    /** Subscriptions looked at in this run. */
+    processed: number;
+    /** Subscriptions left for tomorrow because the batch limit was reached. */
+    moreDue: boolean;
+    /** Charges written to the ledger (or that would be, in a dry run). */
+    recorded: number;
+    /** Cycles passed over without a charge (not active on that date). */
+    skippedInactive: number;
+    /** Charges that already existed for that (subscription, date). */
+    alreadyRecorded: number;
+    /** Subscriptions that stopped at the per-run cycle cap. */
+    capped: number;
+    failed: number;
+};
+
+type OneResult = Pick<RenewalSummary, "recorded" | "skippedInactive" | "alreadyRecorded"> & {
+    capped: boolean;
+    skipped: boolean;
+};
+
+const EMPTY: OneResult = { recorded: 0, skippedInactive: 0, alreadyRecorded: 0, capped: false, skipped: true };
+
+/**
+ * Records every passed renewal of one subscription in ITS OWN ledger and
+ * advances `nextDate`, atomically. Safe to run twice: the row is locked for
+ * the transaction, `nextDate` moves in the same commit as the inserts, and
+ * the unique (subscription_id, date) index rejects a repeated cycle.
+ */
+async function renewOne(id: string, now: Date, dryRun: boolean): Promise<OneResult> {
+    if (dryRun) {
+        const [sub] = await db
+            .select()
+            .from(subscriptions)
+            .where(and(eq(subscriptions.id, id), lte(subscriptions.nextDate, now)))
+            .limit(1);
+        if (!sub) return EMPTY;
+        const plan = planRenewals(sub, now);
+        const charges = plan.cycles.filter((c) => c.charge).length;
+        return {
+            recorded: charges,
+            skippedInactive: plan.cycles.length - charges,
+            alreadyRecorded: 0,
+            capped: plan.capped,
+            skipped: false,
+        };
+    }
+
+    return db.transaction(async (tx) => {
+        const [sub] = await tx
+            .select()
+            .from(subscriptions)
+            .where(and(eq(subscriptions.id, id), lte(subscriptions.nextDate, now)))
+            .for("update", { skipLocked: true });
+        // Gone, already advanced by another run, or locked by one: nothing to do.
+        if (!sub) return EMPTY;
+
+        const plan = planRenewals(sub, now);
+        const charges = plan.cycles.filter((c) => c.charge);
+
+        let recorded = 0;
+        if (charges.length > 0) {
+            const inserted = await tx
+                .insert(transactions)
+                .values(
+                    charges.map((cycle) => ({
+                        userId: sub.userId,
+                        // The subscription's own ledger, never the user's
+                        // personal one: a cron has no request ledger header.
+                        ledgerId: sub.ledgerId,
+                        title: sub.name,
+                        description: sub.note,
+                        amount: sub.price,
+                        currency: sub.currency,
+                        categoryId: sub.categoryId,
+                        subscriptionId: sub.id,
+                        type: "subscription" as const,
+                        action: "created" as const,
+                        date: cycle.date,
+                    })),
+                )
+                .onConflictDoNothing({
+                    target: [transactions.subscriptionId, transactions.date],
+                })
+                .returning({ id: transactions.id });
+            recorded = inserted.length;
+        }
+
+        await tx
+            .update(subscriptions)
+            .set({ nextDate: plan.nextDate, updatedAt: now })
+            .where(eq(subscriptions.id, sub.id));
+
+        return {
+            recorded,
+            skippedInactive: plan.cycles.length - charges.length,
+            alreadyRecorded: charges.length - recorded,
+            capped: plan.capped,
+            skipped: false,
+        };
+    });
+}
+
+export async function processSubscriptionRenewals(
+    options: { now?: Date; dryRun?: boolean; batchSize?: number } = {},
+): Promise<RenewalSummary> {
+    const now = options.now ?? new Date();
+    const dryRun = options.dryRun ?? false;
+    const batchSize = options.batchSize ?? 1000;
+
+    const due = await db
+        .select({ id: subscriptions.id })
+        .from(subscriptions)
+        .where(lte(subscriptions.nextDate, now))
+        .orderBy(asc(subscriptions.nextDate))
+        .limit(batchSize + 1);
+
+    const ids = due.slice(0, batchSize).map((row) => row.id);
+    const summary: RenewalSummary = {
+        dryRun,
+        processed: 0,
+        moreDue: due.length > batchSize,
+        recorded: 0,
+        skippedInactive: 0,
+        alreadyRecorded: 0,
+        capped: 0,
+        failed: 0,
+    };
+
+    for (const id of ids) {
+        try {
+            const result = await renewOne(id, now, dryRun);
+            if (result.skipped) continue;
+            summary.processed++;
+            summary.recorded += result.recorded;
+            summary.skippedInactive += result.skippedInactive;
+            summary.alreadyRecorded += result.alreadyRecorded;
+            if (result.capped) summary.capped++;
+        } catch (error) {
+            // One bad row must not stop everyone else's renewals. Its
+            // transaction rolled back, so it is retried on the next run.
+            console.error(`Renewal failed for subscription ${id}:`, error);
+            summary.failed++;
+        }
+    }
+    return summary;
+}
diff -ruN -x node_modules -x .git stateA/truvora-main/tests/subscription-cycles.test.ts tv2/truvora-main/tests/subscription-cycles.test.ts
--- stateA/truvora-main/tests/subscription-cycles.test.ts	1970-01-01 00:00:00.000000000 +0000
+++ tv2/truvora-main/tests/subscription-cycles.test.ts	2026-11-01 12:47:27.809921176 +0000
@@ -0,0 +1,149 @@
+import { describe, expect, it } from "vitest";
+import {
+    isChargeableOn,
+    MAX_CYCLES_PER_RUN,
+    nextCycleDate,
+    planRenewals,
+    type RenewalSubscription,
+} from "@/lib/subscription-cycles";
+
+const d = (iso: string) => new Date(iso);
+const iso = (date: Date) => date.toISOString();
+
+const monthly = (over: Partial<RenewalSubscription> = {}): RenewalSubscription => ({
+    active: true,
+    startDate: d("2026-01-15T10:00:00.000Z"),
+    endDate: d("9999-12-31T00:00:00.000Z"),
+    deactivatedAt: null,
+    nextDate: d("2026-02-15T10:00:00.000Z"),
+    interval: "month",
+    intervalCount: 1,
+    ...over,
+});
+
+describe("nextCycleDate", () => {
+    it("adds one month and keeps the time of day", () => {
+        expect(iso(nextCycleDate(d("2026-01-15T10:00:00Z"), d("2026-02-15T10:00:00Z"), "month", 1)))
+            .toBe("2026-03-15T10:00:00.000Z");
+    });
+
+    it("anchors on the start day: Jan 31 -> Feb 28 -> Mar 31 (no drift)", () => {
+        const start = d("2026-01-31T00:00:00Z");
+        const feb = nextCycleDate(start, start, "month", 1);
+        expect(iso(feb)).toBe("2026-02-28T00:00:00.000Z");
+        expect(iso(nextCycleDate(start, feb, "month", 1))).toBe("2026-03-31T00:00:00.000Z");
+    });
+
+    it("handles leap years", () => {
+        const start = d("2028-01-31T00:00:00Z");
+        expect(iso(nextCycleDate(start, start, "month", 1))).toBe("2028-02-29T00:00:00.000Z");
+    });
+
+    it("steps intervalCount months", () => {
+        expect(iso(nextCycleDate(d("2026-01-10T00:00:00Z"), d("2026-01-10T00:00:00Z"), "month", 3)))
+            .toBe("2026-04-10T00:00:00.000Z");
+    });
+
+    it("steps years, including Feb 29 -> Feb 28", () => {
+        const start = d("2028-02-29T00:00:00Z");
+        expect(iso(nextCycleDate(start, start, "year", 1))).toBe("2029-02-28T00:00:00.000Z");
+        expect(iso(nextCycleDate(start, d("2029-02-28T00:00:00Z"), "year", 1))).toBe("2030-02-28T00:00:00.000Z");
+    });
+
+    it("rolls over the year boundary", () => {
+        expect(iso(nextCycleDate(d("2026-11-20T00:00:00Z"), d("2026-12-20T00:00:00Z"), "month", 1)))
+            .toBe("2027-01-20T00:00:00.000Z");
+    });
+
+    it("respects a hand-set nextDate on a different day", () => {
+        // Started on the 1st but the user set the next renewal to the 20th.
+        expect(iso(nextCycleDate(d("2026-01-01T00:00:00Z"), d("2026-03-20T00:00:00Z"), "month", 1)))
+            .toBe("2026-04-20T00:00:00.000Z");
+    });
+
+    it("always moves strictly forward, even for bad counts", () => {
+        const start = d("2026-01-01T00:00:00Z");
+        expect(nextCycleDate(start, start, "month", 0).getTime()).toBeGreaterThan(start.getTime());
+    });
+});
+
+describe("isChargeableOn", () => {
+    const sub = monthly();
+    it("charges while active and inside the window", () => {
+        expect(isChargeableOn(sub, d("2026-03-15T10:00:00Z"))).toBe(true);
+    });
+    it("does not charge before the start or after the end", () => {
+        expect(isChargeableOn(sub, d("2026-01-01T00:00:00Z"))).toBe(false);
+        expect(isChargeableOn(monthly({ endDate: d("2026-03-01T00:00:00Z") }), d("2026-04-15T10:00:00Z"))).toBe(false);
+    });
+    it("does not charge an inactive subscription with no deactivation date", () => {
+        expect(isChargeableOn(monthly({ active: false }), d("2026-03-15T10:00:00Z"))).toBe(false);
+    });
+    it("charges cycles before deactivation but not after", () => {
+        const paused = monthly({ active: false, deactivatedAt: d("2026-04-01T00:00:00Z") });
+        expect(isChargeableOn(paused, d("2026-03-15T10:00:00Z"))).toBe(true);
+        expect(isChargeableOn(paused, d("2026-04-15T10:00:00Z"))).toBe(false);
+    });
+});
+
+describe("planRenewals", () => {
+    it("does nothing when nextDate is still in the future", () => {
+        const plan = planRenewals(monthly({ nextDate: d("2026-12-15T10:00:00Z") }), d("2026-11-01T00:00:00Z"));
+        expect(plan.cycles).toEqual([]);
+        expect(iso(plan.nextDate)).toBe("2026-12-15T10:00:00.000Z");
+        expect(plan.capped).toBe(false);
+    });
+
+    it("catches up every missed cycle and lands on the first future date", () => {
+        // nextDate Feb 15; now Nov 1 -> Feb..Oct charged, next is Nov 15.
+        const plan = planRenewals(monthly(), d("2026-11-01T00:00:00Z"));
+        expect(plan.cycles.map((c) => iso(c.date).slice(0, 10))).toEqual([
+            "2026-02-15", "2026-03-15", "2026-04-15", "2026-05-15", "2026-06-15",
+            "2026-07-15", "2026-08-15", "2026-09-15", "2026-10-15",
+        ]);
+        expect(plan.cycles.every((c) => c.charge)).toBe(true);
+        expect(iso(plan.nextDate)).toBe("2026-11-15T10:00:00.000Z");
+    });
+
+    it("treats a cycle exactly at `now` as due", () => {
+        const plan = planRenewals(monthly({ nextDate: d("2026-11-01T00:00:00Z") }), d("2026-11-01T00:00:00Z"));
+        expect(plan.cycles).toHaveLength(1);
+        expect(iso(plan.nextDate)).toBe("2026-12-01T00:00:00.000Z");
+    });
+
+    it("produces no duplicate dates", () => {
+        const plan = planRenewals(monthly(), d("2030-01-01T00:00:00Z"));
+        const dates = plan.cycles.map((c) => c.date.getTime());
+        expect(new Set(dates).size).toBe(dates.length);
+    });
+
+    it("is idempotent: planning from the returned nextDate yields nothing", () => {
+        const now = d("2026-11-01T00:00:00Z");
+        const first = planRenewals(monthly(), now);
+        const second = planRenewals(monthly({ nextDate: first.nextDate }), now);
+        expect(second.cycles).toEqual([]);
+        expect(second.nextDate).toEqual(first.nextDate);
+    });
+
+    it("advances past an inactive subscription without charging", () => {
+        const plan = planRenewals(monthly({ active: false, deactivatedAt: d("2026-02-20T00:00:00Z") }), d("2026-06-01T00:00:00Z"));
+        // Feb 15 is before the Feb 20 deactivation, so it is a real charge;
+        // Mar 15, Apr 15 and May 15 are passed over without charging.
+        expect(plan.cycles.map((c) => c.charge)).toEqual([true, false, false, false]);
+        expect(plan.nextDate.getTime()).toBeGreaterThan(d("2026-06-01T00:00:00Z").getTime());
+    });
+
+    it("stops charging at the end date but still advances nextDate", () => {
+        const plan = planRenewals(monthly({ endDate: d("2026-04-30T00:00:00Z") }), d("2026-08-01T00:00:00Z"));
+        const charged = plan.cycles.filter((c) => c.charge).map((c) => iso(c.date).slice(0, 10));
+        expect(charged).toEqual(["2026-02-15", "2026-03-15", "2026-04-15"]);
+        expect(plan.nextDate.getTime()).toBeGreaterThan(d("2026-08-01T00:00:00Z").getTime());
+    });
+
+    it("caps one run and leaves nextDate in the past so tomorrow continues", () => {
+        const plan = planRenewals(monthly({ nextDate: d("2000-01-15T10:00:00Z"), startDate: d("2000-01-15T10:00:00Z") }), d("2026-11-01T00:00:00Z"));
+        expect(plan.cycles).toHaveLength(MAX_CYCLES_PER_RUN);
+        expect(plan.capped).toBe(true);
+        expect(plan.nextDate.getTime()).toBeLessThanOrEqual(d("2026-11-01T00:00:00Z").getTime());
+    });
+});
diff -ruN -x node_modules -x .git stateA/truvora-main/tests/subscription-renewals-route.test.ts tv2/truvora-main/tests/subscription-renewals-route.test.ts
--- stateA/truvora-main/tests/subscription-renewals-route.test.ts	1970-01-01 00:00:00.000000000 +0000
+++ tv2/truvora-main/tests/subscription-renewals-route.test.ts	2026-11-01 12:47:14.632562028 +0000
@@ -0,0 +1,55 @@
+import { afterEach, beforeEach, describe, expect, it, vi } from "vitest";
+import { NextRequest } from "next/server";
+
+const processSubscriptionRenewals = vi.fn();
+vi.mock("@/lib/subscription-renewals", () => ({
+    processSubscriptionRenewals: (...args: unknown[]) => processSubscriptionRenewals(...args),
+}));
+
+import { GET } from "@/app/api/crons/subscription-renewals/route";
+
+const call = (headers: Record<string, string> = {}, query = "") =>
+    GET(new NextRequest(`http://localhost/api/crons/subscription-renewals${query}`, { headers }));
+
+describe("renewal cron route", () => {
+    const original = process.env.CRON_SECRET;
+    beforeEach(() => {
+        process.env.CRON_SECRET = "s3cret";
+        processSubscriptionRenewals.mockReset();
+    });
+    afterEach(() => {
+        if (original === undefined) delete process.env.CRON_SECRET;
+        else process.env.CRON_SECRET = original;
+    });
+
+    it("is 503 when CRON_SECRET is not configured", async () => {
+        delete process.env.CRON_SECRET;
+        expect((await call()).status).toBe(503);
+        expect(processSubscriptionRenewals).not.toHaveBeenCalled();
+    });
+
+    it("is 401 without the right bearer token", async () => {
+        expect((await call()).status).toBe(401);
+        expect((await call({ authorization: "Bearer nope" })).status).toBe(401);
+        expect(processSubscriptionRenewals).not.toHaveBeenCalled();
+    });
+
+    it("runs the job and reports the summary", async () => {
+        processSubscriptionRenewals.mockResolvedValue({ failed: 0, recorded: 3 });
+        const res = await call({ authorization: "Bearer s3cret" });
+        expect(res.status).toBe(200);
+        expect(await res.json()).toMatchObject({ success: true, recorded: 3 });
+        expect(processSubscriptionRenewals).toHaveBeenCalledWith({ dryRun: false });
+    });
+
+    it("passes dryRun=1 through", async () => {
+        processSubscriptionRenewals.mockResolvedValue({ failed: 0 });
+        await call({ authorization: "Bearer s3cret" }, "?dryRun=1");
+        expect(processSubscriptionRenewals).toHaveBeenCalledWith({ dryRun: true });
+    });
+
+    it("is 500 when any subscription failed, so the scheduler notices", async () => {
+        processSubscriptionRenewals.mockResolvedValue({ failed: 2 });
+        expect((await call({ authorization: "Bearer s3cret" })).status).toBe(500);
+    });
+});
